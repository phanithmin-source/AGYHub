{
  "name": "agyhub",
  "version": "0.1.1",
  "description": "AGYHub — Encrypted multi-account switcher for Antigravity AI (agy). Keep several logins in a passphrase-protected vault and swap the active one with one command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phanithmin-source/AGYHub.git"
  },
  "homepage": "https://github.com/phanithmin-source/AGYHub#readme",
  "bugs": {
    "url": "https://github.com/phanithmin-source/AGYHub/issues"
  },
  "type": "module",
  "bin": {
    "agyhub": "dist/cli.js",
    "agy-hub": "dist/cli.js",
    "ai-locker": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "agyhub",
    "antigravity",
    "agy",
    "gemini",
    "account",
    "switcher",
    "profiles",
    "vault",
    "cli"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
